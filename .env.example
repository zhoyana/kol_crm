DATABASE_URL="mysql://root:password@localhost:3306/kol_crm"
APP_BASE_URL="http://127.0.0.1:3000"
CRAWLER_UV_COMMAND="uv"
CRAWLER_PATH="C:/Program Files/nodejs;C:/Windows/system32;C:/Windows"
CRAWLER_CREATOR_TIMEOUT_MS="90000"
CRAWLER_CREATOR_CONCURRENCY="2"
AGENT_HOMEPAGE_WORK_LIMIT="8"
AGENT_HOMEPAGE_BACKLOG_LIMIT="15"
AGENT_NEW_CANDIDATE_LIMIT="20"
NODE_BINARY="C:/Program Files/nodejs/node.exe"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4-flash"
AGENT_STRATEGY_MODEL="deepseek-v4-flash"
AGENT_STRATEGY_TIMEOUT_MS="20000"
AGENT_STRATEGY_ENABLED="true"
XHS_STORE_RAW_CREATOR=false
REDFOX_API_KEY=
# 小红书默认使用 MatrixFlow 真实浏览器；mediacrawler / redfox 仅作显式备用
XHS_DISCOVERY_PROVIDER=matrixflow
XHS_HOMEPAGE_PROVIDER=matrixflow
MATRIXFLOW_SKILL_DIR="C:/Users/your-name/.codex/skills/matrixflow-browser-control"
MATRIXFLOW_XHS_WINDOW="xhs-crawler"
XHS_MEDIACRAWLER_MAX_NOTES_PER_KEYWORD=100
# 低频采集：每页/每篇详情之间等待一个随机会话节奏（秒）
XHS_MEDIACRAWLER_MIN_DELAY_SECONDS=4
XHS_MEDIACRAWLER_MAX_DELAY_SECONDS=7
LOCAL_AGENT_URL="http://127.0.0.1:17321"
LOCAL_AGENT_PORT="17321"
# Optional. If set, use the same value in the web process and local Agent.
LOCAL_AGENT_TOKEN=""
# Production: route Chrome work to employee-local portable Agents through the central database queue.
LOCAL_AGENT_MODE="direct"
CENTRAL_AGENT_TOKEN="replace-with-a-long-random-token"
CENTRAL_AGENT_JOB_TIMEOUT_MS="600000"
