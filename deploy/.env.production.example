# Copy this file to .env.production on the server and replace placeholders.
# Never commit or send the completed file through an insecure channel.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/biz_cpyx_db"
APP_BASE_URL="http://127.0.0.1:3000"
LOCAL_AGENT_MODE="queue"
CENTRAL_AGENT_TOKEN="REPLACE_WITH_A_LONG_RANDOM_TOKEN"
CENTRAL_AGENT_JOB_TIMEOUT_MS="600000"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL=""

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL=""

AGENT_STRATEGY_ENABLED="true"
AGENT_STRATEGY_MODEL=""
AGENT_STRATEGY_TIMEOUT_MS="120000"

# The worker coordinates the complete Douyin pipeline; Chrome work is delegated to employee Agents.
AGENT_WORKER_POLL_MS="2000"
AGENT_WORKER_LEASE_MS="60000"
AGENT_WORKER_HEARTBEAT_MS="15000"
